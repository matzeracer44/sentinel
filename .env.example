# ═══════════════════════════════════════════════════════
# SENTINEL — API Key Configuration
# ═══════════════════════════════════════════════════════
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# See docs/API_KEYS_GUIDE.md for how to get each key.
# ═══════════════════════════════════════════════════════

# ── REQUIRED ──────────────────────────────────────────

# IP Geolocation — used for IP lookups in Network Monitor
# Get free key: https://ipinfo.io/signup (50k requests/month free)
IPINFO_TOKEN=your_token_here

# ── RECOMMENDED ───────────────────────────────────────

# VirusTotal — used for URL/file scanning in Threat Intelligence
# Get free key: https://www.virustotal.com/gui/join-us (500 requests/day free)
VIRUSTOTAL_API_KEY=your_key_here

# AbuseIPDB — used for IP reputation checks
# Get free key: https://www.abuseipdb.com/register (1000 checks/day free)
ABUSEIPDB_API_KEY=your_key_here

# ── OPTIONAL ──────────────────────────────────────────

# Shodan — used for advanced port/service discovery
# Get free key: https://account.shodan.io/register
SHODAN_API_KEY=


# MaxMind GeoIP2 — higher accuracy geolocation
# Get free key: https://www.maxmind.com/en/geolite2/signup
MAXMIND_LICENSE_KEY=

