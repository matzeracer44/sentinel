# ============================================================
# ARGUS — API Keys
# Kopiere diese Datei zu .env und trage deine API-Keys ein.
#   copy .env.example .env
# Danach ARGUS neu starten.
# ============================================================

# VirusTotal  (kostenlos: https://www.virustotal.com/gui/join-us)
ARGUS_VIRUSTOTAL_KEY=DEIN_KEY_HIER

# AbuseIPDB  (kostenlos: https://www.abuseipdb.com/register)
ARGUS_ABUSEIPDB_KEY=DEIN_KEY_HIER

# AlienVault OTX  (kostenlos: https://otx.alienvault.com/accounts/signup)
ARGUS_OTX_KEY=DEIN_KEY_HIER

# IPinfo.io  (kostenlos: https://ipinfo.io/signup)
ARGUS_IPINFO_TOKEN=DEIN_KEY_HIER

# Sandbox-Modus  (true = keine echten HTTP-Requests, nur Simulation)
ARGUS_SANDBOX_MODE=true
